# Qdrant
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=ommore_kb

# Google (Gemini embeddings)
GOOGLE_API_KEY=your_google_ai_studio_api_key

# Upstash Redis (conversation memory)
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Simple shared secret to protect the /api/ingest route (not a full auth system)
INGEST_SECRET=change_this_to_a_long_random_string
